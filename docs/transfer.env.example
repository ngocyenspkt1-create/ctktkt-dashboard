# Copy this file to .env.local for local development.
# On the destination host, enter the values in its environment settings.
# Never prefix these variables with NEXT_PUBLIC_.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
AUTH_SECRET=

# Optional Gemini fallback. The shared Gemini key can also be entered in the UI.
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-3.5-flash-lite

# Optional scheduled cleanup, Google Sheets and read-only data integration.
CRON_SECRET=
GOOGLE_SHEET_APPS_SCRIPT_URL=
GOOGLE_SHEET_SYNC_TOKEN=
GOOGLE_MIRROR_TOKEN=
PXVH1_READ_API_KEY_SHA256=

# Only used when intentionally provisioning new users; not a login password export.
INITIAL_USER_PASSWORD=
